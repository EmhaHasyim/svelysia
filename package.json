{
	"name": "svelysia",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "wrangler types && bunx --bun vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"deploy": "bun run build && wrangler deploy",
		"prepare": "svelte-kit sync && wrangler types || echo ''",
		"check": "wrangler types && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "oxlint --deny-warnings .",
		"format": "oxfmt .",
		"format:check": "oxfmt --check .",
		"verify": "bun run gen && bun run check && bun run lint && bun run format:check && bun run test && bun run build",
		"test": "vitest run",
		"gen": "wrangler types"
	},
	"dependencies": {
		"@elysia/eden": "2.0.0-rc.1",
		"@elysia/openapi": "2.0.0-rc.1",
		"elysia": "2.0.0-rc.4"
	},
	"devDependencies": {
		"@sveltejs/adapter-cloudflare": "9",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"oxfmt": "^0.79.0",
		"oxlint": "^1.94.0",
		"svelte": "^5.58.0",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "6",
		"vite": "^8.3.8",
		"vitest": "^5.1.1",
		"wrangler": "^4.165.0"
	},
	"packageManager": "bun@1.4.4"
}
